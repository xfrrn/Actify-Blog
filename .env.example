# Required: PostgreSQL database owned by the application role.
# Set the real password only in .env.local or the server environment.
DATABASE_URL=postgresql://actify:CHANGE_ME@127.0.0.1:5432/actify_blog
# Optional directory containing pg_dump and pg_restore, if not on PATH.
PG_BIN_DIR=
# Optional test connection with CREATEDB permission; defaults to DATABASE_URL.
TEST_DATABASE_URL=
# Local/legacy uploads only; database files are managed by PostgreSQL.
# Production uses a persistent directory outside the checkout; local default .data/.
DATA_DIR=
# Exact public origin. For local development use http://localhost:3000.
SITE_ORIGIN=http://localhost:3000
# Set to 1 only behind the supplied Nginx proxy; do not expose the Node port.
TRUST_PROXY=0
# Optional: Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=

# Local development can use local; set r2 on the server.
# Production defaults to r2 when MEDIA_STORAGE is omitted.
MEDIA_STORAGE=local
# Copy the S3 API endpoint from the R2 bucket settings (no bucket/path suffix).
R2_ENDPOINT=
R2_BUCKET=blog
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public HTTPS origin (not the S3 API endpoint).
R2_PUBLIC_URL=https://img.actify.cc
