# 本地复制为 .env.local；生产配置写入 /etc/actify.env。

# 数据库（必填）：先创建数据库和账号，启动时自动建表。
# 密码中的特殊字符需要 URL 编码。
DATABASE_URL=postgresql://actify:CHANGE_ME@127.0.0.1:5432/actify_blog

# 后台登录（必填）：密码 12–256 个字符；修改后重启，旧会话失效。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 自动保护：登录每 IP 10 次/10 分钟，全站 100 次/10 分钟。
# 后台写入 120 次/分钟，图片上传 20 次/分钟。

# 网站地址：生产改为实际 HTTPS 域名，不带末尾 /。
SITE_ORIGIN=http://localhost:3000
# 使用配套 Caddy 反代时设为 1，Node 端口仅监听本机。
TRUST_PROXY=0

# 图片存储：本地用 local，生产改为 r2。
MEDIA_STORAGE=local

# 使用 r2 时填写以下配置。
# S3 API 地址，从存储桶设置复制，不带桶名或路径。
R2_ENDPOINT=
R2_BUCKET=blog
# 该存储桶的 S3 读写密钥。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 图片公开 HTTPS 域名，不是 S3 API 地址。
R2_PUBLIC_URL=https://img.actify.cc

# 以下为可选配置。
# pg_dump / pg_restore 所在目录；已加入 PATH 则留空。
PG_BIN_DIR=
# 测试连接，账号需有 CREATEDB 权限；留空使用 DATABASE_URL。
TEST_DATABASE_URL=
# Google Search Console 的 HTML 标签验证码。
GOOGLE_SITE_VERIFICATION=
