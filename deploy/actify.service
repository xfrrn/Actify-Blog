[Unit]
Description=Actify blog
After=network.target postgresql.service

[Service]
Type=simple
User=actify
Group=actify
WorkingDirectory=/opt/actify
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/actify
Environment=SITE_ORIGIN=https://actify.cc
Environment=TRUST_PROXY=1
Environment=MEDIA_STORAGE=r2
EnvironmentFile=/etc/actify.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
