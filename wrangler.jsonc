{
  // Legacy D1 export configuration only. The application now runs on Node.js.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "actify-blog",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "actify-blog-feedback",
      "migrations_dir": "migrations"
    }
  ]
}
