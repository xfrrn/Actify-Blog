{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "actify-blog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "actify.cc", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
